<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.logan.goose-nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/namto/agentic-platform/scripts/run-job.sh</string>
    <string>nightly</string>
    <string>--</string>
    <string>/bin/bash</string>
    <string>/Users/namto/agentic-platform/scripts/nightly-digest.sh</string>
    <string>namlogan/agentic-platform</string>
