# Telegram alert config — COPY this to /Users/namto/.config/agentic/alert.env
# (the real file is gitignored; never commit your token).
#
# How to get the two values (30 seconds, on your phone):
#   1. In Telegram, open @BotFather → /newbot → follow prompts.
#      It gives you a token like 123456789:AAH... → that's TELEGRAM_BOT_TOKEN.
#   2. Send any message to your new bot (tap it, press Start, say "hi").
#   3. Get your chat id: open in a browser (paste your token):
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#      Find  "chat":{"id":123456789,...}  → that number is TELEGRAM_CHAT_ID.
#
# Then put the real file on BOTH machines:
#   M1:  /Users/namto/.config/agentic/alert.env
#   RTX: ~/.agentic/alert.env   (for the dead-man switch)

TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PUT_YOUR_CHAT_ID_HERE
