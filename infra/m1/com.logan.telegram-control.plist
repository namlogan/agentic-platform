<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.logan.telegram-control</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/namto/agentic-platform/scripts/telegram-control.sh</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>WorkingDirectory</key><string>/Users/namto/agentic-platform</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/namto/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/namto</string>
    <key>OLLAMA_HOST</key><string>http://milai:11434</string>
    <key>PLATFORM_REPO</key><string>namlogan/agentic-platform</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/namto/Library/Logs/telegram-control.log</string>
  <key>StandardErrorPath</key><string>/Users/namto/Library/Logs/telegram-control.err</string>
</dict>
</plist>
